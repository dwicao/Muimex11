<!--
  Lint policy for Muimex11.

  Everything lint calls an *error* blocks CI (see the `lint` block in
  app/build.gradle.kts). Only checks that provably cannot be violated here are
  demoted, each with the reason it is safe.
-->
<lint>

    <!-- java.util.Formatter's %s accepts any object, so `getString(R.string.showing_n, count)`
         renders correctly even when the resource uses %s and the argument is an
         int. These strings keep %s on purpose: a translation may legitimately
         replace the number with a word ("beberapa"). Demoted so the ~160
         harmless occurrences do not hide real format bugs (which still show up
         as warnings in the uploaded report). -->
    <issue id="StringFormatMatches" severity="warning" />

    <!-- PACKAGE_USAGE_STATS is required for the foreground-app detection used by
         Game Space and per-game profiles; it is declared with an explicit
         tools:ignore at the declaration site. -->
    <issue id="ProtectedPermissions" severity="warning" />

</lint>
